# Supabase 项目设置 → API 页面可以找到
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 网站正式网址（快递确认链接、邮件里的链接会用到）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 发信邮箱：用你现有的邮箱（Gmail 要用“应用专用密码”）。不填则邮件只保存在后台，不真正发出
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=orders@your-domain.com
SMTP_PASS=
EMAIL_FROM=東京輸入食品 <orders@your-domain.com>

# 选填：不用自己的邮箱时，也可以用 https://resend.com
RESEND_API_KEY=
